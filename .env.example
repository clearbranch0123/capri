# API Keys for Capri AI Companion

# DeepSeek API Key (Official DeepSeek-V3 / R1)
# Сайт: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Groq API Key (Current active LLM & Fast Whisper STT)
GROQ_API_KEY=

# SambaNova API Key (Fast Llama 3.3, gpt-oss-120b, MiniMax)
SAMBANOVA_API_KEY=

# Fish Audio API Key (Recommended for expressive neural voice — Bring Your Own Voice)
# Site: https://fish.audio — create your own API key and pick any voice matching your chat language (EN or RU)
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# ElevenLabs API Key (Alternative neural cloud voice — Bring Your Own Voice)
# Site: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Gemini API Key (для LLM и нативной генерации аудио Gemini 2.0)
# Получить в 1 клик с Google-аккаунтом: https://aistudio.google.com
GEMINI_API_KEY=

# OpenAI / OpenRouter (альтернативы)
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
